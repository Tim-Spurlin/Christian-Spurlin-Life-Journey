{
  "hosting": {
    "site": "christiankota-com",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "christiankota",
          "region": "us-central1"
        }
      }
    ]
  }
}
